[Unit]
Description=Captive Portal
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/captive
EnvironmentFile=/opt/captive/.env
ExecStart=/usr/bin/node /opt/captive/server.js
Restart=always
RestartSec=3
User=captive
Group=captive
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/captive/data

[Install]
WantedBy=multi-user.target
